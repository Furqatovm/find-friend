# ==========================================
# WithMe Production Backend Environment
# ==========================================

# Server Configuration
PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# Security Keys (Generate strong random secrets for production)
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key-in-production
JWT_ACCESS_EXP_HOURS=24
JWT_REFRESH_EXP_DAYS=30

# Database Configuration
# In production, co-locate your PostgreSQL database with the app server (e.g. within the same region or VPS)
# Example local/VPS: postgresql://withme_user:password@localhost:5432/withme_db
# Example managed (Neon, Supabase, RDS):
DATABASE_URL=postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require

# CORS Configuration (Set specific production domain or * for dev)
CORS_ORIGINS=https://withme.app,http://localhost:3000

# Telegram Bot (Optional, for error and notification alerts)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789
